{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gus-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // El Worker decide antes que los archivos en la raíz y en las páginas de idioma
    "run_worker_first": ["/", "/index.html", "/ca", "/ca/*", "/es", "/es/*", "/en", "/en/*"]
  },
  "observability": { "enabled": true }
}
